# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev: postgresql://ahbar:ahbar@localhost:15432/ahbarandco
# Production: postgresql://USER:PASSWORD@VPS_IP:5432/ahbarandco?sslmode=require
DATABASE_URL="postgresql://ahbar:ahbar@localhost:15432/ahbarandco"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: npx auth secret  OR  openssl rand -base64 32
AUTH_SECRET=""
# Production only — set to your domain
# AUTH_URL="https://ahbarandco.com"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Redirect URI to add: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="1096423878243-uaskidsb8clr2bbq152t5bdaghk0qp5u.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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"

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Get from: dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_* for development, rzp_live_* for production
RAZORPAY_KEY_ID="rzp_test_T0B7NpUNXXBLRW"
RAZORPAY_KEY_SECRET="OzKkbSzFMNiZQ3yDukq2j1Z3"
RAZORPAY_WEBHOOK_SECRET=""
# Must match RAZORPAY_KEY_ID — used in client-side Checkout.js widget
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_T0B7NpUNXXBLRW"

# ─── Cloudflare R2 (Image Storage) ────────────────────────────────────────────
# Required for Vercel production (local disk won't work on serverless)
# Get from: dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ahbarandco-media"
# Public URL for your R2 bucket (set up custom domain in R2 settings)
R2_PUBLIC_URL="https://media.ahbarandco.com"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Geocoding (Google Maps) ──────────────────────────────────────────────────
# Optional: Set this to enable Google Maps Reverse Geocoding in production checkout.
# If unset, the app falls back to the free Nominatim (OpenStreetMap) API.
GOOGLE_MAPS_API_KEY=""

# ─── SMTP Mail Server (Password Reset) ────────────────────────────────────────
